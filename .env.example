# ═══════════════════════════════════════════════════════════════
#  CONVERA — Environment Variables
#  وزارة البلديات والإسكان — إدارة التطوير والتأهيل
#
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (Required) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key-placeholder>

# Service role — server-side only, never expose to browser
# SUPABASE_SERVICE_ROLE_KEY=<server-side-secret-placeholder>

# ─── Auth redirect URLs (set in Supabase dashboard) ───────────
# Auth → URL Configuration → Redirect URLs:
#   https://convera.momah.gov.sa/reset-password
#   http://localhost:3000/reset-password
